# Copy to .env in your invocation directory; never commit credentials.
# Shell values override .env. The scanner never loads the target repository's .env.
GEMINI_API_KEY=
GEMFORGE_MODEL=gemma-4-26b-a4b-it
# Organizers confirmed hosted Gemma 4 is permitted for Track 1.
# Explicit opt-in still controls disclosure of each repository's excerpts.
# GEMFORGE_ALLOW_HOSTED=true
# GEMFORGE_TIMEOUT_MS=60000
# GEMFORGE_MAX_ATTEMPTS=2
# GEMFORGE_BACKOFF_SECONDS=1
